{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Ringkasan Sistem & Performa API",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum(count_over_time({app=\"erm-dokter\"} | json | method != \"\" [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Total Error (5xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum(count_over_time({app=\"erm-dokter\"} | json | status >= 500 [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Client Warnings (4xx)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum(count_over_time({app=\"erm-dokter\"} | json | status >= 400 and status < 500 [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Login Dokter Berhasil",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum(count_over_time({app=\"erm-dokter\"} | json | msg =~ \"(?i).*login.*\" [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "Request Throughput by Status (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum by (status) (rate({app=\"erm-dokter\"} | json | method != \"\" [1m]))",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Application Errors & Warnings (per min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "sum by (level) (count_over_time({app=\"erm-dokter\"} | json | level =~ \"(?i)error|warn\" [1m]))",
          "legendFormat": "Level {{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 200,
      "title": "Live Logs Explorer",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Live Application Log Stream",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "$datasource" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "$datasource" },
          "expr": "{app=\"erm-dokter\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["erm-dokter", "khanza", "logs"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "ERM Dokter - System & Access Observability",
  "uid": "erm-dokter-observability",
  "version": 2
}
